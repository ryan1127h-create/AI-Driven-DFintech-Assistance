[importlinter]
root_package = app

[importlinter:contract:layers]
name = app layered architecture
type = layers
layers =
    app.api
    app.orchestrator
    app.tools
    app.domains
    app.adapters
    app.ports
    app.core

; auth (identity) and checklist (the résumé file profile reads) are the two
; domains everything else may legitimately depend on; profile sits above
; checklist. Course recommendation receives a complete Agent report and is
; intentionally isolated from every data-owning domain. Domains listed on the
; same line, separated by "|", are siblings: neither may import the other.
[importlinter:contract:domain-layers]
name = domains form their own internal dependency order
type = layers
layers =
    app.domains.escalation | app.domains.application_tracker | app.domains.alumni_match
    app.domains.career_planning | app.domains.program_comparison
    app.domains.course_recommendation | app.domains.profile
    app.domains.checklist | app.domains.knowledge_retrieval
    app.domains.auth | app.domains.course_catalog

[importlinter:contract:course-recommendation-agent-report-only]
name = course recommendation cannot access profile or data stores
type = forbidden
source_modules =
    app.domains.course_recommendation
forbidden_modules =
    app.domains.profile
    app.domains.knowledge_retrieval
    app.domains.course_catalog
    app.adapters.knowledge_db_adapter
    app.adapters.conversation_db_adapter
    app.adapters.redis_cache_adapter
