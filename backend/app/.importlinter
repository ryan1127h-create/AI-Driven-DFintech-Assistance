[importlinter]
root_package = app

[importlinter:contract:layers]
name = app layered architecture
type = layers
layers =
    app.api
    app.orchestrator
    app.tools
    app.domains
    app.adapters
    app.ports
    app.core

; The data-owning domains, highest first: a domain may import (the
; interface of) a domain below it, never one above. Domains on the same
; line, separated by "|", are siblings: neither may import the other.
; checklist links applications (sis) to accounts (auth) and lifecycle
; stages (profile); lifecycle shows a student's sis record and their degree
; progress, computed by the course_recommendation specialist's pure
; curriculum rules; cv_import reads an uploaded CV with the cv_extraction
; specialist and stores the checked result in profile (those two are the
; only specialists a data domain imports); derived_labels computes labels
; from profile, sis and knowledge (reusing lifecycle's degree progress
; rules) and stores them in profile; auth
; records the registration stage and consent in profile; profile validates
; role tags against knowledge_retrieval.
; Every domain's api.py resolves the caller through auth's
; get_current_user_id dependency - HTTP plumbing, not a domain dependency -
; so those imports are exempt.
[importlinter:contract:domain-layers]
name = data-owning domains form their own dependency order
type = layers
layers =
    app.domains.checklist | app.domains.lifecycle | app.domains.cv_import | app.domains.derived_labels
    app.domains.auth
    app.domains.profile
    app.domains.sis | app.domains.knowledge_retrieval | app.domains.conversation | app.domains.program_catalog
ignore_imports =
    app.domains.*.api -> app.domains.auth.interface

; Specialist agents read no data themselves: the tools layer assembles
; every input (profile facts, knowledge-base content, retrieval context)
; and passes it in. They may use the LLM adapter, nothing else below.
[importlinter:contract:specialists-get-data-from-tools]
name = specialist agents never read data themselves
type = forbidden
source_modules =
    app.domains.specialist
forbidden_modules =
    app.domains.auth
    app.domains.checklist
    app.domains.conversation
    app.domains.knowledge_retrieval
    app.domains.profile
    app.domains.program_catalog
    app.domains.sis
    app.adapters.postgres_pool
    app.adapters.account_db_adapter
    app.adapters.profile_db_adapter
    app.adapters.sis_db_adapter
    app.adapters.chat_db_adapter
    app.adapters.knowledge_db_adapter
    app.adapters.program_db_adapter
    app.adapters.redis_cache_adapter
    app.adapters.openai_embedding_adapter
    app.adapters.supabase_auth_adapter
    app.adapters.resend_email_adapter

[importlinter:contract:specialists-independent]
name = specialist agents do not import each other
type = independence
modules =
    app.domains.specialist.assessment
    app.domains.specialist.career_planning
    app.domains.specialist.course_recommendation
    app.domains.specialist.cv_extraction
    app.domains.specialist.knowledge_qa
    app.domains.specialist.program_comparison

; course_recommendation's internal structure (see its workflow.py and
; stages/__init__.py). The domain is pure computation: no adapter at all,
; not even the LLM - selection is deterministic.
[importlinter:contract:course-rec-domain-pure]
name = course recommendation domain uses no adapter
type = forbidden
source_modules =
    app.domains.specialist.course_recommendation
forbidden_modules =
    app.adapters

; Each stage takes the previous stage's output (models) and reads rules
; from policy; only workflow.py sequences them.
[importlinter:contract:course-rec-stages-independent]
name = course recommendation stages do not import each other
type = independence
modules =
    app.domains.specialist.course_recommendation.stages.s3_constraints
    app.domains.specialist.course_recommendation.stages.s4_slots
    app.domains.specialist.course_recommendation.stages.s5_scoring
    app.domains.specialist.course_recommendation.stages.s6_modes

[importlinter:contract:course-rec-policy-leaf]
name = course recommendation policy depends on nothing in its domain
type = forbidden
source_modules =
    app.domains.specialist.course_recommendation.policy
forbidden_modules =
    app.domains.specialist.course_recommendation.contracts
    app.domains.specialist.course_recommendation.errors
    app.domains.specialist.course_recommendation.interface
    app.domains.specialist.course_recommendation.models
    app.domains.specialist.course_recommendation.schemas
    app.domains.specialist.course_recommendation.stages
    app.domains.specialist.course_recommendation.workflow

; In the course recommendation tool only s2_assembly/prefetch.py reads the
; profile or the knowledge base; understanding works from the message alone,
; the builder and the presentation from what prefetch gathered.
[importlinter:contract:course-rec-tool-io-boundary]
name = course recommendation tool reads data only in prefetch
type = forbidden
source_modules =
    app.tools.specialist.course_recommendation.s1_understanding
    app.tools.specialist.course_recommendation.s2_assembly.builder
    app.tools.specialist.course_recommendation.s2_assembly.mappers
    app.tools.specialist.course_recommendation.s2_assembly.prefetched
    app.tools.specialist.course_recommendation.s2_assembly.prerequisites
    app.tools.specialist.course_recommendation.s2_assembly.terms
    app.tools.specialist.course_recommendation.s7_presentation
forbidden_modules =
    app.domains.knowledge_retrieval
    app.domains.profile
    app.adapters.postgres_pool
    app.adapters.profile_db_adapter
    app.adapters.knowledge_db_adapter

; career_planning's internal structure (see its workflow.py and
; stages/__init__.py). The domain is pure computation: no adapter at all,
; not even the LLM - grades, fits and roadmaps are deterministic.
[importlinter:contract:career-domain-pure]
name = career planning domain uses no adapter
type = forbidden
source_modules =
    app.domains.specialist.career_planning
forbidden_modules =
    app.adapters

; Each stage takes the previous stage's output (models) and reads rules
; from policy; only workflow.py sequences them.
[importlinter:contract:career-stages-independent]
name = career planning stages do not import each other
type = independence
modules =
    app.domains.specialist.career_planning.stages.s3_evidence
    app.domains.specialist.career_planning.stages.s4_fit
    app.domains.specialist.career_planning.stages.s5_roadmap
    app.domains.specialist.career_planning.stages.s6_modes

[importlinter:contract:career-policy-leaf]
name = career planning policy depends on nothing in its domain
type = forbidden
source_modules =
    app.domains.specialist.career_planning.policy
forbidden_modules =
    app.domains.specialist.career_planning.contracts
    app.domains.specialist.career_planning.errors
    app.domains.specialist.career_planning.interface
    app.domains.specialist.career_planning.models
    app.domains.specialist.career_planning.schemas
    app.domains.specialist.career_planning.stages
    app.domains.specialist.career_planning.workflow

; In the career planning tool only s2_assembly/prefetch.py reads the
; profile or the knowledge base (gate.py, which the orchestrator calls
; before the tool runs, reads the profile too); understanding works from
; the message and the catalogue it is given, the builder and the
; presentation from what prefetch gathered.
[importlinter:contract:career-tool-io-boundary]
name = career planning tool reads data only in prefetch and the gate
type = forbidden
source_modules =
    app.tools.specialist.career_planning.s1_understanding
    app.tools.specialist.career_planning.s2_assembly.builder
    app.tools.specialist.career_planning.s2_assembly.prefetched
    app.tools.specialist.career_planning.s7_presentation
forbidden_modules =
    app.domains.knowledge_retrieval
    app.domains.profile
    app.adapters.postgres_pool
    app.adapters.profile_db_adapter
    app.adapters.knowledge_db_adapter
