# Kimi / Moonshot AI chat model.
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k2.7-code-highspeed

# OpenAI embedding for query-time RAG retrieval.
OPENAI_API_KEY=

# Read-only knowledge database, used by app/repositories/knowledge_repository.py.
KNOWLEDGE_DATABASE_URL=

# Conversation/profile database, required by supabase_cached session storage
# and by the profile module.
CONVERSATION_DATABASE_URL=

# Session storage: memory, redis, or supabase_cached.
SESSION_STORE_BACKEND=memory
REDIS_URL=redis://localhost:6379/0
SESSION_TTL_SECONDS=86400

# RAG cache.
RETRIEVAL_CACHE_TTL_SECONDS=21600

# Conversation history summarization.
HISTORY_BLOCK_SIZE=10
HISTORY_RAW_TAIL_MAX=15
FREEZE_LOCK_TTL_SECONDS=60
