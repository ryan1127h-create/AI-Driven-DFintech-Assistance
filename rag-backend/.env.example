# 复制这个文件为 .env，再填入自己的真实值。
# .env 已被 .gitignore 挡住，不会（也绝不能）上传到 GitHub。
# 真实 key 请找负责人私下索取，不要提交到仓库。

# --- 数据库（Supabase PostgreSQL）---
# 注意：填这个就是连同一个库，改删数据会互相影响。要各用各的请自建 Supabase 项目。
DATABASE_URL=

# --- Embedding（切片入库、向量检索都要用）---
OPENAI_API_KEY=

# --- Rerank（四层检索的第四层）---
COHERE_API_KEY=

# --- 回答生成 LLM（走 NVIDIA build 免费通道，OpenAI 兼容接口）---
# key 在 https://build.nvidia.com 申请，nvapi- 开头
NVIDIA_API_KEY=
LLM_MODEL=deepseek-ai/deepseek-v4-pro
# 可选：换别的 OpenAI 兼容端点时改这个，默认走 NVIDIA
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
