# Template for the repo-root .env file consumed by both backend and
# frontend (see backend/app/core/config.py for the authoritative list this
# is generated from, and frontend/vite.config.js's envDir for why the
# frontend also reads this same file). Copy to `.env` and fill in real
# values — never commit the real `.env`.

# --- DeepSeek — OpenAI-API-compatible chat-completion backend used by every
# LLM call in the app (see app/adapters/deepseek_adapter.py) ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- The one Supabase Postgres project backing both student.users and
# every other per-user table (profiles, checklist items, conversations,
# ...) AND schema `knowledge` (table `document_chunks`, plus the
# course/career-role/curriculum-rule chunks course_recommendation parses)
# — read by two separate adapters (conversation_db_adapter.py,
# knowledge_db_adapter.py) but one connection string ---
DATABASE_URL=

# --- Query-time embeddings for hybrid retrieval — unrelated to DeepSeek ---
OPENAI_API_KEY=

# How long a retrieval result stays cached before being recomputed (seconds)
RETRIEVAL_CACHE_TTL_SECONDS=21600

# --- Cache / session / token-blacklist store ---
REDIS_URL=redis://localhost:6379/0

# Which ConversationStore backend the orchestrator uses (see
# orchestrator/conversation_repository.py): "memory" (default, no Redis
# required), "redis", or "supabase_cached"
SESSION_STORE_BACKEND=memory
SESSION_TTL_SECONDS=86400

# Block-based incremental history summarization (see
# orchestrator/conversation_service.py)
HISTORY_BLOCK_SIZE=10
HISTORY_RAW_TAIL_MAX=15

# How long a session's processing/summarizing lock is honored before being
# treated as stale (seconds)
FREEZE_LOCK_TTL_SECONDS=90

# Per-branch cap for the orchestrator's multi-tool parallel dispatch (seconds)
DISPATCH_BRANCH_TIMEOUT_SECONDS=45

# Kill switches for the orchestrator's post-answer evaluation / reply-language
# localization steps (see orchestrator/dispatch/evaluation.py,
# orchestrator/dispatch/localization.py)
ENABLE_ANSWER_EVALUATION=true
ENABLE_LOCALIZATION=true

# Emergency off switch for the pre-execution requirements gate (see
# orchestrator/dispatch/requirements.py) — costs no LLM call either way,
# so this exists only to disable it in production without a deploy if a
# tool's required_input check turns out to be wrong.
ENABLE_INPUT_REQUIREMENTS_GATE=true

# --- Supabase project URL + API keys (Project Settings -> API) — same
# project as DATABASE_URL above, but these are API-style credentials, not
# the Postgres DSN, since Storage/Auth are accessed through their own REST
# APIs rather than SQL. service_role is for privileged calls (checklist
# file uploads, creating an account, see
# app/adapters/supabase_storage_adapter.py and supabase_auth_adapter.py);
# anon is used for the user-facing sign-in call only. There's no separate
# JWT-secret setting: access-token verification (see
# app/domains/auth/security.py) fetches the current signing key straight
# from this project's own JWKS endpoint, derived from SUPABASE_URL. ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=
CHECKLIST_STORAGE_BUCKET=checklist-documents

# --- Email verification codes (see app/domains/auth/service.py +
# app/adapters/resend_email_adapter.py). Leaving RESEND_API_KEY unset makes
# the adapter print the code to the server log instead of emailing it — fine
# for local dev, but must be set for a real deployment or registration
# emails never reach real users ---
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=onboarding@resend.dev
EMAIL_VERIFICATION_TTL_SECONDS=600
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
EMAIL_VERIFICATION_MAX_ATTEMPTS=5

# --- CORS — comma-separated list of allowed frontend origins ---
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# --- Frontend (Vite) — see frontend/api.js ---
VITE_API_BASE=http://localhost:8000/api/v1
